# 复制为 .env 后填写真实值；本文件只提交占位，禁止写入真实密钥

# 会话ID签名密钥（强烈建议配置）：不配置时服务会随机生成，
# 重启后旧会话全部失效，且多实例部署时会话无法互相校验
SESSION_SECRET=

# 服务
NODE_ENV=development
PORT=3001
# 开启后会把请求细节写入日志（含已脱敏的 URL）
DEBUG=false
# 日志级别：silent/error/warn/info/debug，缺省 info（DEBUG=true 时等价 debug）
# error 与 warn 始终输出到 stderr，不受 DEBUG 影响；生产建议 info
LOG_LEVEL=info

# 大模型
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# 单次 LLM 请求超时（毫秒）
LLM_TIMEOUT_MS=15000
SILICON_FLOW_API_KEY=

# 高德地图 / 天气
MAP_API_KEY=
WEATHER_API_KEY=

# Redis 会话存储（不配置则连接 localhost:6379；连不上会降级到内存）
REDIS_URL=redis://localhost:6379
